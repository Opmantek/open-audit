{
    "name": "firstwave/open-audit",
    "description": "Open-AudIT",
    "license": "LicenseRef-Proprietary-FirstWave-202502",
    "type": "project",
    "homepage": "https://open-audit.com",
    "support": {
        "wiki": "https://docs.community.firstwave.com/wiki/spaces/OA/overview?homepageId=3163947010",
        "source": "https://github.com/Opmantek/open-audit",
        "email": "support.nmis@firstwave.com"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-gettext": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-ldap": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "ext-snmp": "*",
        "aws/aws-sdk-php": "^3.281",
        "codeigniter4/framework": "^4.7",
        "foxworth42/oauth2-okta": "^1.0",
        "google/auth": "^1.50",
        "gravitypdf/querypath": "^4.1",
        "kint-php/kint": "^5.1",
        "laminas/laminas-escaper": "^2.18",
        "league/oauth2-client": "^2.9",
        "league/oauth2-github": "^3.1",
        "masterminds/html5": "^2.10",
        "paragonie/sodium_compat": "^1.24",
        "phpoffice/phpspreadsheet": "^5.7",
        "phpseclib/phpseclib": "^3.0",
        "thenetworg/oauth2-azure": "^2.2",
        "league/commonmark": "^2.9"
    },
    "require-dev": {
        "codeigniter/coding-standard": "^1.9",
        "ergebnis/composer-normalize": "^2.50",
        "fakerphp/faker": "^1.24",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^9.6",
        "vimeo/psalm": "^6.15"
    },
    "suggest": {
        "ext-fileinfo": "Improves mime type detection for files"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app",
            "Config\\": "app/Config"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OpenAuditTest\\Integration\\": "tests/Integration",
            "OpenAuditTest\\Support\\": "tests/Support",
            "OpenAuditTest\\Unit\\": "tests/Unit"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "process-timeout": 0,
        "platform": {
            "php": "8.2.99"
        }
    },
    "scripts": {
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "psalm:check": "psalm",
        "psalm:report": "psalm --report=.report/psalm.xml  --report-show-info=false --show-info=false",
        "test": "phpunit --colors=always",
        "test:coverage": "phpunit --colors=always --coverage-text --display-all-issues",
        "test:file": "phpunit --colors=always --filter",
        "test:integration": "phpunit --testsuite integration --colors=always",
        "test:report": "phpunit --do-not-cache-result --log-junit=.report/phpunit.xml --coverage-clover=.report/coverage-clover.xml --coverage-cobertura=.report/coverage-cobertura.xml --colors=never --coverage-text",
        "test:unit": "phpunit --testsuite unit --colors=always"
    }
}
